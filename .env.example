# ==============================================================================
# YatraFlow — Environment Configuration (.env.example)
# Copy this file to .env and configure your credentials as needed.
# All features have fallback to DEMO/SIMULATOR mode when keys are omitted.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Aviation & Meteorology Feeds (Free & Open Priority)
# ------------------------------------------------------------------------------
# Aviationstack API Key (Optional: commercial live flight schedule feed)
AVIATIONSTACK_API_KEY=

# OpenSky Network ADS-B live transponder telemetry (1 = enabled, 0 = demo standby)
OPEN_SKY_ENABLED=1

# Open-Meteo live weather forecasts (1 = enabled, 0 = demo weather)
OPEN_METEO_ENABLED=1

# Dashboard poll interval in seconds
REFRESH_SECONDS=30

# ------------------------------------------------------------------------------
# 2. Supabase (Database, Auth & Realtime)
# ------------------------------------------------------------------------------
# Project URL from Supabase dashboard -> Project Settings -> API
SUPABASE_URL=

# Supabase public anonymous key (anon / public)
SUPABASE_ANON_KEY=

# Supabase secret service role key (service_role)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. n8n Webhook & Event Automation
# ------------------------------------------------------------------------------
# Outbound webhook endpoint on your n8n instance (e.g. self-hosted or n8n cloud)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/yatraflow-events

# HMAC-SHA256 signature secret shared between YatraFlow and n8n
N8N_WEBHOOK_SECRET=yatraflow-n8n-secure-secret-2026

# ------------------------------------------------------------------------------
# 4. Meta WhatsApp Business Cloud API
# ------------------------------------------------------------------------------
# WhatsApp Phone Number ID from Meta Developer Dashboard
WHATSAPP_PHONE_NUMBER_ID=

# Meta WhatsApp Graph API User/System User Permanent Access Token
WHATSAPP_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 & Calendar
# ------------------------------------------------------------------------------
# Google Cloud Console Web OAuth Client ID
GOOGLE_CLIENT_ID=

# Google Cloud Console Web OAuth Client Secret
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6. Deployment & Security
# ------------------------------------------------------------------------------
# Public API base URL (e.g. https://yatraflow-api.onrender.com or http://localhost:8000)
API_BASE_URL=http://localhost:8000

# Additional comma-separated allowed origins for CORS
ALLOWED_ORIGINS=https://yatraflow.onrender.com

# Set to 1 in HTTPS production environments, 0 for localhost HTTP
COOKIE_SECURE=0
